# Base URL of CameraApp Central. The agent adds /api/v1 if it is not included.
CAMERA_APP_CENTRAL_API_URL=

# One-time key issued when the edge agent is enrolled. Never commit the real value.
CAMERA_APP_AGENT_API_KEY=

# Code of the local SQLite store that maps to the central store.
CAMERA_APP_LOCAL_STORE_CODE=local

# Non-sensitive operational identity shown in central diagnostics.
CAMERA_APP_AGENT_NAME=
CAMERA_APP_AGENT_VERSION=0.3.0

# Sync behavior. Events remain in SQLite until CameraApp Central confirms them.
CAMERA_APP_SYNC_INTERVAL_SECONDS=30
CAMERA_APP_SYNC_BATCH_SIZE=50

# Optional mapping for the Mac/device-local camera, whose local channel is not numeric.
# Use the same numeric channel that will exist in CameraApp Central.
CAMERA_APP_DEFAULT_CAMERA_CHANNEL=

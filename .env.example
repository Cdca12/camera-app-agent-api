# Base URL of CameraApp Central. The agent adds /api/v1 if it is not included.
CAMERA_APP_CENTRAL_API_URL=

# One-time key issued when the edge agent is enrolled. Never commit the real value.
CAMERA_APP_AGENT_API_KEY=

# Code of the local SQLite store that maps to the central store.
CAMERA_APP_LOCAL_STORE_CODE=local

# Non-sensitive operational identity shown in central diagnostics.
CAMERA_APP_AGENT_NAME=
CAMERA_APP_AGENT_VERSION=0.4.0

# Sync behavior. Events remain in SQLite until CameraApp Central confirms them.
CAMERA_APP_SYNC_INTERVAL_SECONDS=30
CAMERA_APP_SYNC_BATCH_SIZE=50

# Optional mapping for the Mac/device-local camera, whose local channel is not numeric.
# Use the same numeric channel that will exist in CameraApp Central.
CAMERA_APP_DEFAULT_CAMERA_CHANNEL=

# Persistent state must be outside the Git checkout. The Fernet key is created
# beside CAMERA_APP_DB_PATH; include both files in a protected local backup.
CAMERA_APP_DB_PATH=/var/lib/cameraapp/camera_app_operational.db
CAMERA_APP_TEST_DB_PATH=/var/lib/cameraapp/camera_app_test.db
CAMERA_APP_MODEL_DIR=/var/lib/cameraapp/models

# Recolección optimizada para Raspberry Pi 3 B+: analiza el substream Hikvision
# (por ejemplo, 501 -> 502), espera entre ciclos y protege la memoria disponible.
CAMERA_COLLECTION_USE_SUBSTREAM=true
CAMERA_COLLECTION_INTERVAL_SECONDS=20
CAMERA_APP_MIN_INFERENCE_MEMORY_MB=250

# Optional pilot protection for local technical endpoints. When set, all
# endpoints except /health and documentation require this request header:
# X-CameraApp-Local-Key. Keep the real value only in /etc/cameraapp/agent.env.
CAMERA_APP_LOCAL_API_KEY=
